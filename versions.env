# Pinned versions of the globally installed agent tools. `setup.sh reload`
# sources this file and installs exactly these versions, so two hosts that
# check out the same commit end up with the same toolchain.
#
# Upstream publishes no tags we can follow safely -- graphifyy alone has over
# 200 releases -- so tracking "latest" made every `reload` a silent upgrade.
# Bumping one is deliberate: `./bin/pins.sh latest` shows what is available,
# edit the line here, then `./setup.sh reload && make ci`. A graphifyy bump
# also needs `./setup.sh agents-init`, because the skill it deploys into
# ~/.claude/skills/graphify records the version it came from.
#
# Package name vs binary name differs for all three:
#   graphifyy (PyPI)                 -> graphify
#   headroom-ai (PyPI)               -> headroom
#   @colbymchenry/codegraph (npm)    -> codegraph
GRAPHIFYY_VERSION=0.9.64
HEADROOM_VERSION=0.37.0
CODEGRAPH_VERSION=1.6.0
