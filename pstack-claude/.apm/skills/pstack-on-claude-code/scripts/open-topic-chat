#!/usr/bin/env bash
# Open a topic chat: a worktree `chat-<topic>` of the coordinator repo, the
# harness installed in it, and a claude session started there on the hand-off.
#
#   open-topic-chat [--run <run_id>] [--repo <selector>] [--agent-cmd <command>]
#                   --said <words> [--known <facts>] [--guess <guesses>] <topic>
#
# The hand-off comes in three parts so a guess cannot pass for what the human
# said: --said is the human's words verbatim (required), --known what they
# stated or the repo shows, --guess what the main chat inferred. A part left out
# reads （なし）. The role and, with --run, the Run to bind are added here.
# --agent-cmd is the command that starts the chat; the hand-off is appended to
# it as the last argument. It is the one place that decides which agent and
# model the chat runs on, so whatever picks them (a person today, a router
# later) only has to pass it. The default starts Claude on Opus in plan mode,
# with --model explicit so a topic chat never inherits the main chat's model
# from settings. --repo defaults to the repo whose worktree contains the current
# directory, read from `orca worktree list`.
#
# The command is typed into the shell Orca opens with the worktree, so the
# worktree has one terminal. Only a shell verifiably waiting at a prompt is used;
# otherwise a terminal of our own is opened (and the shell stays, as before).
# Prints the worktree path and the terminal handle.
set -euo pipefail

usage() { echo "usage: open-topic-chat [--run <run_id>] [--repo <selector>] [--agent-cmd <command>] --said <words> [--known <facts>] [--guess <guesses>] <topic>" >&2; exit 2; }

agent_cmd="claude --model claude-opus-5-5 --permission-mode plan"
run="" repo="" said="" known="" guess=""
while [ $# -gt 0 ]; do
  case "$1" in
    --run) [ $# -ge 2 ] || usage; run="$2"; shift 2 ;;
    --repo) [ $# -ge 2 ] || usage; repo="$2"; shift 2 ;;
    --agent-cmd) [ $# -ge 2 ] && [ -n "$2" ] || usage; agent_cmd="$2"; shift 2 ;;
    --said) [ $# -ge 2 ] || usage; said="$2"; shift 2 ;;
    --known) [ $# -ge 2 ] || usage; known="$2"; shift 2 ;;
    --guess) [ $# -ge 2 ] || usage; guess="$2"; shift 2 ;;
    -h|--help) usage ;;
    --) shift; break ;;
    -*) usage ;;
    *) break ;;
  esac
done
[ $# -eq 1 ] && [ -n "$said" ] || usage
topic="$1"
case "$topic" in
  ''|*[!a-z0-9-]*|-*) echo "open-topic-chat: topic must be kebab-case: $topic" >&2; exit 2 ;;
esac

# `orca ... --json` prints {"ok":false,...} for a refused call, so check ok
# rather than the exit status alone.
orca_json() {
  local out
  out="$(orca "$@" --json)" || { printf '%s\n' "$out" >&2; return 1; }
  printf '%s' "$out" | jq -e '.ok == true' >/dev/null || { printf '%s\n' "$out" >&2; return 1; }
  printf '%s' "$out"
}

if [ -z "$repo" ]; then
  here="$(git rev-parse --show-toplevel 2>/dev/null)" || here="$PWD"
  id="$(orca_json worktree list | jq -r --arg here "$here" \
    '[.result.worktrees[] | select(.path == $here) | .repoId][0] // empty')"
  [ -n "$id" ] || { echo "open-topic-chat: $here is not an Orca worktree; pass --repo" >&2; exit 1; }
  repo="id:$id"
fi

# home-k8s's per-topic token dashboard keys off this name (coordinator-chat-<topic>); don't rename.
created="$(orca_json worktree create --repo "$repo" --name "chat-$topic" --setup skip --no-parent)"
# Orca names the worktree by id, "<repoId>::<path>"; older builds also gave a path.
path="$(printf '%s' "$created" | jq -r '(.result.worktree // {}) | (.path // ((.id // "") | split("::") | .[1:] | join("::"))) | select(. != "")')"
[ -n "$path" ] || { echo "open-topic-chat: no worktree path in: $created" >&2; exit 1; }

# .claude/ and apm_modules/ are gitignored, so a fresh worktree has no harness.
(cd "$path" && apm install)

role="You are the topic chat for \`$topic\`. You start in plan mode: ground the hand-off with the human before the first \`worker-start\` (pstack-on-claude-code's grounding.md; ask with AskUserQuestion). Dispatch workers with \`worker-start\`; do not implement. Follow pstack-on-claude-code's 'Supervising Orca workers', Topic chat. Wait with its \`wait-worker-events\`, and write nothing for heartbeats or empty waits."
if [ -n "$run" ]; then
  role="$role Bind the Run this topic already has with \`orca orchestration run-use --id $run\`; do not create a new Run."
fi

# The hand-off goes through a file: \`cat\` keeps quotes and newlines out of the
# command Orca types into the terminal.
file="$(mktemp "${TMPDIR:-/tmp}/topic-chat-$topic.XXXXXX")"
printf '%s\n\n## ユーザーの原文\n%s\n\n## わかっていること\n%s\n\n## 推測（要確認）\n%s\n' \
  "$role" "$said" "${known:-（なし）}" "${guess:-（なし）}" > "$file"

launch="$agent_cmd \"\$(cat $(printf %q "$file"))\""

# The terminal Orca opened with the worktree, if it is the only one and sits at
# a shell prompt that has stopped moving. Prints its handle. `terminal wait` has
# nothing for this: `tui-idle` is for agent TUIs and times out on a shell.
waiting_shell() {
  local deadline=$((SECONDS + ${OPEN_TOPIC_CHAT_SHELL_WAIT:-15})) list handle a b
  while [ "$SECONDS" -lt "$deadline" ]; do
    list="$(orca_json terminal list --worktree "path:$path")" || return 1
    if [ "$(printf '%s' "$list" | jq '.result.terminals | length')" = 1 ]; then
      handle="$(printf '%s' "$list" | jq -r '.result.terminals[0].handle')"
      a="$(shell_screen "$handle")" || return 1
      sleep 0.5
      b="$(shell_screen "$handle")" || return 1
      if [ "$a" = "$b" ] && printf '%s' "$b" | tail -n 1 | grep -qE '(\$|#|%|>|❯|»|➜)[[:space:]]*$'; then
        printf '%s' "$handle"; return 0
      fi
    fi
    sleep 0.5
  done
  return 1
}
# The cursor and the last non-blank line: equal twice running means it is idle.
shell_screen() {
  orca_json terminal read --terminal "$1" \
    | jq -r '.result.terminal | (.latestCursor | tostring), ([.tail[] | select(test("\\S"))] | last // "")'
}

if handle="$(waiting_shell)" &&
   orca_json terminal send --terminal "$handle" --text "$launch" --enter >/dev/null; then
  orca_json terminal rename --terminal "$handle" --title "$topic" >/dev/null || true
else
  echo "open-topic-chat: the startup shell is not a lone shell at a prompt; opening a terminal" >&2
  terminal="$(orca_json terminal create --worktree "path:$path" --title "$topic" --command "$launch")"
  handle="$(printf '%s' "$terminal" | jq -r '.result.terminal.handle // .result.handle // "unknown"')"
fi

printf 'worktree: %s\n' "$path"
printf 'terminal: %s\n' "$handle"
