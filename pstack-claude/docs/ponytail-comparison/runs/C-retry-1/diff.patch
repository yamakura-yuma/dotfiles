+
+def http_error(test, code):
+    err = urllib.error.HTTPError(URL, code, "msg", None, io.BytesIO())
+    test.addCleanup(err.close)
+    return err
+
+
+def body(quantity):
+    return io.BytesIO(json.dumps({"quantity": quantity}).encode())
+
+
+class BrokenRead:
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc_info):
+        return False
+
+    def read(self):
+        raise ConnectionResetError()
+
 
 class GetStockTest(unittest.TestCase):
