+def notify_slack(text):
+    url = os.environ.get("SLACK_WEBHOOK_URL")
+    if not url:
+        return
+    try:
+        _post_json(url, {"text": text})
+    except Exception:  # a Slack outage must not fail shipping
+        log.warning("slack notification failed", exc_info=True)
