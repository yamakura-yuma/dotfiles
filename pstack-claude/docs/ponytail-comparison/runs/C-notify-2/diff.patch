+def send_email(to, subject, body):
+    _post_json(os.environ["MAIL_API_URL"], {"to": to, "subject": subject, "body": body})
+
+
+def notify_slack(text):
+    """Best-effort: an ops chat outage must not fail a shipped order."""
+    url = os.environ.get("SLACK_WEBHOOK_URL")
+    if not url:
+        return
+    try:
+        _post_json(url, {"text": text})
+    except OSError:
+        log.warning("slack notify failed", exc_info=True)
+
+
 def ship_order(order):
