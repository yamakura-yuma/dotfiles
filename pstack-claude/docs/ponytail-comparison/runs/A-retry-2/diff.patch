+import http.client
 import json
+import time
+import urllib.error
 import urllib.request
 
 BASE_URL = "https://inventory.internal/api"
 
+RETRY_DELAYS = (0.5, 1.0)
+
 
 def get_stock(sku):
+    for delay in RETRY_DELAYS:
+        try:
+            return _fetch_quantity(sku)
+        except Exception as exc:
+            if not _is_transient(exc):
+                raise
+            if isinstance(exc, urllib.error.HTTPError):
+                exc.close()
+        time.sleep(delay)
+    return _fetch_quantity(sku)
+
+
+def _fetch_quantity(sku):
     with urllib.request.urlopen(f"{BASE_URL}/stock/{sku}", timeout=5) as resp:
         return json.load(resp)["quantity"]
+
+
+def _is_transient(exc):
+    # Case order is load-bearing: HTTPError subclasses URLError, so it must
+    # come first or it would match the generic URLError case instead.
+    match exc:
+        case urllib.error.HTTPError(code=code):
+            return 500 <= code <= 599
+        case urllib.error.URLError(reason=OSError()):
+            return True
+        case urllib.error.URLError():
+            return False
+        case TimeoutError() | ConnectionError() | http.client.IncompleteRead():
+            return True  # raised raw while json.load reads the body
+        case _:
+            return False
